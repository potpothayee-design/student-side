# Copy this file to .env for local development. On Render, set these under Environment.

# Render PostgreSQL connection string.
#  - On Render (web service in the same region): use the "Internal Database URL"
#  - On your own computer: use the "External Database URL"
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Optional
COOKIE_NAME=canteen_student
# NODE_ENV=production   (Render: set this so cookies are HTTPS-only)
# DATABASE_SSL=true     (force SSL on/off; auto-detected for Render URLs)
